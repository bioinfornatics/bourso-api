{
    "name": "Rust [minimal]",
    "runArgs": [
        "--name",
        "bourso-api-dev"
    ],
    "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm@sha256:86d9228ec0744191b45ec91e2bb9a0dd7d7bfd4c4f01ef47abb78032ddddf1c7",
    "remoteUser": "vscode",
    "postCreateCommand": "rustup toolchain install 1.96.1 --profile minimal --component clippy --component rustfmt --component llvm-tools-preview",
    "customizations": {
        "vscode": {
            "settings": {
                "editor.formatOnSave": true,
                "terminal.integrated.defaultProfile.linux": "bash",
                "rust-analyzer.check.command": "clippy",
                "evenBetterToml.formatter.alignEntries": true,
                "evenBetterToml.formatter.columnWidth": 100,
                "[rust]": {
                    "editor.defaultFormatter": "rust-lang.rust-analyzer"
                },
                "[toml]": {
                    "editor.defaultFormatter": "tamasfe.even-better-toml"
                }
            },
            "extensions": [
                "rust-lang.rust-analyzer",
                "vadimcn.vscode-lldb",
                "tamasfe.even-better-toml",
                "fill-labs.dependi",
                "github.vscode-github-actions"
            ]
        }
    }
}
